{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overcenter.dev/contracts/postconditions-v1/schema.json",
  "title": "Overcenter postconditions v1",
  "$defs": {
    "NonEmptyNoNulString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "GithubObjectId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "GithubExpectedState": {
      "enum": [
        "error",
        "failure",
        "pending",
        "success"
      ]
    },
    "FileContentEquals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "path",
        "content"
      ],
      "properties": {
        "verifier": {
          "const": "file-content-equals/v1"
        },
        "path": {
          "$ref": "#/$defs/NonEmptyNoNulString"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "EventuallyConsistentFileContentEquals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "path",
        "content"
      ],
      "properties": {
        "verifier": {
          "const": "eventually-consistent-file-content-equals/v1"
        },
        "path": {
          "$ref": "#/$defs/NonEmptyNoNulString"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "GithubCommitStatusV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "provider",
        "repository_id",
        "commit_sha",
        "context",
        "expected_state"
      ],
      "properties": {
        "verifier": {
          "const": "github-commit-status/v1"
        },
        "provider": {
          "const": "github"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "commit_sha": {
          "$ref": "#/$defs/GithubObjectId"
        },
        "context": {
          "$ref": "#/$defs/NonEmptyNoNulString"
        },
        "expected_state": {
          "$ref": "#/$defs/GithubExpectedState"
        }
      }
    },
    "GithubCommitStatusV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "provider",
        "repository_id",
        "repository_full_name",
        "commit_sha",
        "context",
        "expected_state"
      ],
      "properties": {
        "verifier": {
          "const": "github-commit-status/v2"
        },
        "provider": {
          "const": "github"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "repository_full_name": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^/\\u0000]+/[^/\\u0000]+$"
        },
        "commit_sha": {
          "$ref": "#/$defs/GithubObjectId"
        },
        "context": {
          "$ref": "#/$defs/NonEmptyNoNulString"
        },
        "expected_state": {
          "$ref": "#/$defs/GithubExpectedState"
        }
      }
    },
    "KubernetesConfigMapExists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "provider",
        "authority_id",
        "api_group",
        "resource",
        "namespace",
        "name"
      ],
      "properties": {
        "verifier": {
          "const": "kubernetes-configmap-exists/v1"
        },
        "provider": {
          "const": "kubernetes"
        },
        "authority_id": {
          "$ref": "#/$defs/NonEmptyNoNulString"
        },
        "api_group": {
          "const": ""
        },
        "resource": {
          "const": "configmaps"
        },
        "namespace": {
          "$ref": "#/$defs/NonEmptyNoNulString"
        },
        "name": {
          "$ref": "#/$defs/NonEmptyNoNulString"
        }
      }
    },
    "Postcondition": {
      "oneOf": [
        {
          "$ref": "#/$defs/FileContentEquals"
        },
        {
          "$ref": "#/$defs/EventuallyConsistentFileContentEquals"
        },
        {
          "$ref": "#/$defs/GithubCommitStatusV1"
        },
        {
          "$ref": "#/$defs/GithubCommitStatusV2"
        },
        {
          "$ref": "#/$defs/KubernetesConfigMapExists"
        }
      ]
    }
  }
}
