{
  "apiVersion": "overcenter.dev/data-contract/v1",
  "kind": "DataContract",
  "id": "observation-evidence",
  "version": "1.0.0",
  "status": "active",
  "description": {
    "purpose": "Define provider-neutral observations, settlement observation envelopes, and absence-evidence certificates without confusing structural evidence with settlement authority.",
    "limitations": "Envelope validity never grants negative-evidence authority by itself. Provider/verifier-specific matchers must bind evidence to the exact postcondition coordinate and completeness semantics."
  },
  "participants": {
    "producers": [
      "provider-adapters",
      "trusted-observers"
    ],
    "consumers": [
      "verifiers",
      "settlement",
      "durable-receipts"
    ]
  },
  "schema": {
    "format": "json-schema",
    "draft": "https://json-schema.org/draft/2020-12/schema",
    "path": "./schema.json",
    "entrypoints": {
      "providerObservation": "#/$defs/ProviderObservation",
      "settlementObservation": "#/$defs/SettlementObservation",
      "absenceEvidenceEnvelope": "#/$defs/AbsenceEvidenceEnvelope",
      "knownAuthoritativeAbsenceEvidence": "#/$defs/KnownAuthoritativeAbsenceEvidence"
    },
    "validationExtensions": [
      "x-overcenter-providerOwned",
      "x-overcenter-kindOwned"
    ],
    "generatedDefinitions": {
      "SettlementObservation": {
        "source": "./settlement-observation.typebox.ts",
        "generator": "../../scripts/generate-settlement-observation.mjs",
        "toolchain": "typebox==1.3.34; typescript==7.0.2 for static proof",
        "outputs": [
          "./schema.json#/$defs/SettlementObservation",
          "../../src/generated/settlement-observation-schema.ts"
        ],
        "externalReferences": [
          "absence_evidence -> #/$defs/AbsenceEvidenceEnvelope"
        ],
        "toolchainClosure": "TypeBox is installed only in the projection proof. Production runtime consumes checked-in generated structure through deterministic repository code and requires no npm install."
      }
    }
  },
  "compatibility": {
    "unknownProviderObservationFields": "reject unless explicitly declared as a provider extension",
    "unknownSettlementObservationFields": "reject",
    "absenceEnvelopeUnknownFields": "reject",
    "changeRule": "New provider-specific evidence kinds may extend the generic envelope only through a new recognized kind contract; authority is opt-in, not inherited."
  },
  "governance": {
    "structureAuthority": "./schema.json",
    "providerEnvelopeValidator": "../../src/provider-observation/observation.ts",
    "settlementEnvelopeValidator": "../../src/observation.ts",
    "absenceEnvelopeValidator": "../../src/evidence.ts",
    "conflictPolicy": "machine-readable-structure-wins",
    "generatedOutputIsNotVerifiedOutput": true,
    "settlementObservationStructureSource": "./settlement-observation.typebox.ts"
  },
  "semanticRoles": {
    "providerObservation": {
      "contractBindingFields": [
        "contract.provider",
        "contract.api_version",
        "contract.operation_id",
        "contract.schema_sha256"
      ],
      "provenanceFields": [
        "observer",
        "observed_at"
      ],
      "coordinateFields": [
        "request"
      ],
      "transportMetadataFields": [
        "response"
      ],
      "resultFields": [
        "outcome"
      ],
      "note": "Provider-specific coordinate and response semantics remain in provider adapters. structural_validation is a derived schema-binding certificate; revalidated_from records exact conditional-HTTP provenance. Both are known derived stages, not provider-owned extension buckets.",
      "derivedFields": [
        "structural_validation",
        "revalidated_from"
      ]
    },
    "settlementObservation": {
      "bindingFields": [
        "verifier"
      ],
      "certaintyField": "mutation_certainty",
      "absenceEvidenceField": "absence_evidence",
      "providerEvidenceField": "provider_evidence",
      "note": "Verifier-specific coordinate checks determine whether a structurally valid observation applies to the postcondition."
    },
    "absenceEvidence": {
      "envelopeFields": [
        "schema",
        "kind",
        "subject",
        "scope",
        "snapshot",
        "completeness",
        "provenance"
      ],
      "authorityRule": "The generic envelope carries evidence. Only a kind-specific matcher accepted by the verifier can make negative evidence authoritative."
    }
  },
  "providerExtensions": [
    {
      "provider": "kubernetes",
      "observation": "KubernetesConfigMapListObservation",
      "topLevelFields": [
        {
          "name": "authority_id",
          "required": true,
          "kind": "non-empty-string"
        }
      ],
      "rationale": "Cluster authority identity is part of the observed coordinate and is required before structural certification."
    }
  ],
  "knownAbsenceEvidenceKinds": [
    {
      "kind": "local-file-enoent/v1",
      "matcher": "localFileEnoentEvidenceMatches",
      "source": "../../src/evidence.ts"
    },
    {
      "kind": "kubernetes-complete-list-absence/v1",
      "matcher": "kubernetesConfigMapAbsenceEvidenceMatches",
      "source": "../../src/providers/kubernetes-configmap.ts"
    }
  ],
  "quality": [
    {
      "id": "provider-envelope-regression",
      "type": "executable",
      "path": "../../test/provider-observation.test.ts"
    },
    {
      "id": "absence-envelope-regression",
      "type": "executable",
      "path": "../../test/evidence-pure.test.ts"
    },
    {
      "id": "kubernetes-negative-evidence",
      "type": "executable",
      "path": "../../test/kubernetes-core-verifier.test.ts"
    },
    {
      "id": "contract-regression",
      "type": "executable",
      "path": "../../test/data-contracts.test.ts"
    }
  ],
  "extensions": {},
  "authoritativeDefinitions": [
    {
      "type": "wire-schema",
      "path": "./schema.json"
    },
    {
      "type": "settlement-observation-structural-source",
      "path": "./settlement-observation.typebox.ts"
    },
    {
      "type": "provider-envelope-validator",
      "path": "../../src/provider-observation/observation.ts"
    },
    {
      "type": "settlement-envelope-validator",
      "path": "../../src/observation.ts"
    },
    {
      "type": "absence-envelope-validator",
      "path": "../../src/evidence.ts"
    },
    {
      "type": "kubernetes-absence-matcher",
      "path": "../../src/providers/kubernetes-configmap.ts"
    }
  ]
}
