{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overcenter.dev/contracts/authority-facts-v1/schema.json",
  "title": "Overcenter durable authority facts v1",
  "description": "Persisted logical fact envelopes. Shape validity is necessary but not sufficient for replay validity.",
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ControlDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "upstream"
      ],
      "properties": {
        "kind": {
          "const": "control"
        },
        "upstream": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "SemanticConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "selector"
      ],
      "properties": {
        "kind": {
          "enum": [
            "output",
            "evidence"
          ]
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "SemanticDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "upstream",
        "consumes"
      ],
      "properties": {
        "kind": {
          "const": "semantic"
        },
        "upstream": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "consumes": {
          "$ref": "#/$defs/SemanticConsumption"
        }
      }
    },
    "Dependency": {
      "oneOf": [
        {
          "$ref": "#/$defs/ControlDependency"
        },
        {
          "$ref": "#/$defs/SemanticDependency"
        }
      ]
    },
    "ClaimFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "obligation_id",
        "claimed_revision",
        "obligation_key",
        "execution_capability_sha256"
      ],
      "properties": {
        "schema": {
          "const": "overcenter-git-claim-v3"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "claimed_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "obligation_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "execution_capability_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "ExecutionAuthorityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "obligation_id",
        "generation",
        "previous_authority_commit",
        "execution_capability_sha256"
      ],
      "properties": {
        "schema": {
          "const": "overcenter-git-execution-authority-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_authority_commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "execution_capability_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "EffectReservationFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "obligation_id",
        "execution_generation",
        "execution_authority_commit"
      ],
      "properties": {
        "schema": {
          "const": "overcenter-git-effect-reservation-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "execution_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execution_authority_commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "DiagnosticPayload": {
      "type": "object",
      "x-overcenter-openBoundary": true,
      "additionalProperties": true,
      "description": "Non-authoritative diagnostic payload."
    },
    "ReceiptFactV5": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "obligation_id",
        "claimed_revision",
        "claim_commit",
        "execution_generation",
        "execution_authority_commit",
        "kind",
        "observed",
        "settled_at"
      ],
      "properties": {
        "schema": {
          "const": "overcenter-git-receipt-v5"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "claimed_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "claim_commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "execution_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execution_authority_commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "kind": {
          "enum": [
            "observation",
            "judgment-required",
            "execution-terminated"
          ]
        },
        "observed": {
          "oneOf": [
            {
              "$ref": "#/$defs/CurrentObservationPayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic": {
          "$ref": "#/$defs/DiagnosticPayload"
        },
        "settled_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "ReceiptFact": {
      "$ref": "#/$defs/ReceiptFactV5"
    },
    "AuthorityFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/GraphPatchFact"
        },
        {
          "$ref": "#/$defs/ClaimFact"
        },
        {
          "$ref": "#/$defs/ExecutionAuthorityFact"
        },
        {
          "$ref": "#/$defs/EffectReservationFact"
        },
        {
          "$ref": "#/$defs/ReceiptFact"
        }
      ]
    },
    "CurrentObservationPayload": {
      "$ref": "../observation-evidence-v1/schema.json#/$defs/SettlementObservation"
    },
    "ObligationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencies",
        "packet",
        "postcondition"
      ],
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        },
        "packet": {
          "type": "object",
          "x-overcenter-openBoundary": true,
          "additionalProperties": true,
          "description": "Application-defined packet; intentionally open but authoritative by value."
        },
        "postcondition": {
          "type": "object",
          "x-overcenter-openBoundary": true,
          "additionalProperties": true,
          "required": [
            "verifier"
          ],
          "description": "Verifier-owned postcondition contract; intentionally open here."
        }
      }
    },
    "DefinitionFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "definition": {
          "$ref": "#/$defs/ObligationDefinition"
        }
      }
    },
    "BindingFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "definition_id"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "definition_id": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "GraphPatchFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "definitions",
        "bindings",
        "retire"
      ],
      "properties": {
        "schema": {
          "const": "overcenter-graph-patch-v1"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefinitionFact"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BindingFact"
          }
        },
        "retire": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "bindings": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "retire": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
