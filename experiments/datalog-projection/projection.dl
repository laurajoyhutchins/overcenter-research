// Overcenter Datalog projection experiment.
//
// Input contract:
//   - durable definition / dependency / run / receipt history is already
//     structurally validated by the authority/replay boundary;
//   - current semantic identity, observation meaning, and realization
//     admissibility are recomputed by deterministic semantic machinery.
//
// Datalog accepts no lifecycle state and no receipt disposition.

.decl definition(obligation:symbol, definition_id:symbol, sequence:number)
.input definition

.decl current_semantic_key(obligation:symbol, semantic_key:symbol)
.input current_semantic_key

.decl dependency(
    downstream:symbol,
    definition_id:symbol,
    upstream:symbol,
    kind:symbol
)
.input dependency

.decl run(run_id:symbol, obligation:symbol, semantic_key:symbol, sequence:number)
.input run

.decl receipt(run_id:symbol, kind:symbol, sequence:number)
.input receipt

.decl observation_judgment(
    run_id:symbol,
    receipt_sequence:number,
    verified:symbol,
    accepted_absence:symbol
)
.input observation_judgment

.decl current_realization_admissible(run_id:symbol, obligation:symbol)
.input current_realization_admissible

// ----- Current graph -------------------------------------------------------

.decl superseded_definition(obligation:symbol, sequence:number)
superseded_definition(O, N) :-
    definition(O, DefinitionId, N),
    definition(O, DefinitionId2, N2),
    N2 > N.

.decl current_definition(obligation:symbol, definition_id:symbol)
current_definition(O, DefinitionId) :-
    definition(O, DefinitionId, N),
    !superseded_definition(O, N).

.decl current_obligation(obligation:symbol)
current_obligation(O) :- current_definition(O, DefinitionId).

.decl current_dependency(downstream:symbol, upstream:symbol, kind:symbol)
current_dependency(D, U, Kind) :-
    current_definition(D, DefinitionId),
    dependency(D, DefinitionId, U, Kind).

.decl dependency_closure(downstream:symbol, upstream:symbol)
dependency_closure(D, U) :- current_dependency(D, U, Kind).
dependency_closure(D, U) :-
    current_dependency(D, M, Kind),
    dependency_closure(M, U).

.output dependency_closure

// ----- Settlement ---------------------------------------------------------
//
// Provider/verifier semantics reduce an observation to two booleans. Datalog
// owns only the provider-neutral mapping from those judgments to disposition.

.decl receipt_disposition(
    run_id:symbol,
    receipt_sequence:number,
    disposition:symbol
)

receipt_disposition(R, N, "DONE") :-
    receipt(R, "observation", N),
    observation_judgment(R, N, "true", "false").

receipt_disposition(R, N, "READY") :-
    receipt(R, "observation", N),
    observation_judgment(R, N, "false", "true").

receipt_disposition(R, N, "RECOVERY_REQUIRED") :-
    receipt(R, "observation", N),
    observation_judgment(R, N, "false", "false").

receipt_disposition(R, N, "WAITING") :-
    receipt(R, "judgment-required", N).

receipt_disposition(R, N, "RECOVERY_REQUIRED") :-
    receipt(R, "execution-terminated", N).

.decl superseded_receipt(run_id:symbol, sequence:number)
superseded_receipt(R, N) :-
    receipt(R, Kind, N),
    receipt(R, Kind2, N2),
    N2 > N.

.decl latest_receipt_record(run_id:symbol, sequence:number)
latest_receipt_record(R, N) :-
    receipt(R, Kind, N),
    !superseded_receipt(R, N).

.decl ambiguous_receipt(run_id:symbol, sequence:number)
ambiguous_receipt(R, N) :-
    receipt_disposition(R, N, D1),
    receipt_disposition(R, N, D2),
    D1 != D2.

.decl latest_receipt(run_id:symbol, disposition:symbol)
latest_receipt(R, D) :-
    latest_receipt_record(R, N),
    receipt_disposition(R, N, D),
    !ambiguous_receipt(R, N).

.decl has_latest_receipt(run_id:symbol)
has_latest_receipt(R) :- latest_receipt_record(R, N).

.decl uninterpretable_latest_receipt(run_id:symbol)
uninterpretable_latest_receipt(R) :-
    latest_receipt_record(R, N),
    !latest_receipt(R, _).

// ----- Realization --------------------------------------------------------

.decl matching_run(run_id:symbol, obligation:symbol, sequence:number)
matching_run(R, O, N) :-
    run(R, O, K, N),
    current_obligation(O),
    current_semantic_key(O, K).

.decl done(obligation:symbol)
done(O) :-
    matching_run(R, O, N),
    latest_receipt(R, "DONE"),
    current_realization_admissible(R, O).

.decl superseded_matching_run(run_id:symbol)
superseded_matching_run(R) :-
    matching_run(R, O, N),
    matching_run(R2, O, N2),
    N2 > N.

.decl latest_matching_run(run_id:symbol, obligation:symbol)
latest_matching_run(R, O) :-
    matching_run(R, O, N),
    !superseded_matching_run(R).

.decl executing(obligation:symbol)
executing(O) :-
    latest_matching_run(R, O),
    !done(O),
    !has_latest_receipt(R).

.decl waiting(obligation:symbol)
waiting(O) :-
    latest_matching_run(R, O),
    !done(O),
    latest_receipt(R, "WAITING").

.decl recovery_required(obligation:symbol)
recovery_required(O) :-
    latest_matching_run(R, O),
    !done(O),
    latest_receipt(R, "RECOVERY_REQUIRED").

recovery_required(O) :-
    latest_matching_run(R, O),
    !done(O),
    uninterpretable_latest_receipt(R).

.decl unrealized(obligation:symbol)
unrealized(O) :-
    current_obligation(O),
    !done(O),
    !executing(O),
    !waiting(O),
    !recovery_required(O).

// ----- Eligibility --------------------------------------------------------
//
// Both edge kinds gate execution. Only semantic edges gate semantic-key
// availability, which is why the one-bit distinction survives flattening.

.decl unsatisfied_dependency(obligation:symbol, upstream:symbol)
unsatisfied_dependency(O, U) :-
    unrealized(O),
    current_dependency(O, U, Kind),
    !done(U).

.decl has_unsatisfied_dependency(obligation:symbol)
has_unsatisfied_dependency(O) :- unsatisfied_dependency(O, U).

.decl blocked(obligation:symbol)
blocked(O) :-
    unrealized(O),
    has_unsatisfied_dependency(O).

.decl ready(obligation:symbol)
ready(O) :-
    unrealized(O),
    current_semantic_key(O, K),
    !has_unsatisfied_dependency(O).

// If semantic dependencies are unresolved, current_semantic_key may
// legitimately be absent. If all dependencies are DONE and the key is still
// absent, no status is emitted; the consumer's totality check fails closed.

.decl project_status(obligation:symbol, status:symbol)
project_status(O, "DONE") :- done(O).
project_status(O, "EXECUTING") :- executing(O).
project_status(O, "WAITING") :- waiting(O).
project_status(O, "RECOVERY_REQUIRED") :- recovery_required(O).
project_status(O, "BLOCKED") :- blocked(O).
project_status(O, "READY") :- ready(O).

.output project_status
