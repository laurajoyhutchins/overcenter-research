// Projection bake-off: same normalized current facts as the SQL alternative.
//
// Structural validation, provider interpretation, and semantic-key computation
// are intentionally upstream. This file only derives project status.

.decl obligation(id:symbol)
.input obligation

.decl dependency(downstream:symbol, upstream:symbol)
.input dependency

.decl semantic_key(obligation:symbol, key:symbol)
.input semantic_key

.decl run(id:symbol, obligation:symbol, key:symbol, sequence:number)
.input run

.decl receipt(run:symbol, disposition:symbol, sequence:number)
.input receipt

.decl admissible_run(run:symbol)
.input admissible_run

.decl superseded_receipt(run:symbol, sequence:number)
superseded_receipt(R,N) :-
  receipt(R,D,N),
  receipt(R,D2,N2),
  N2>N.

.decl latest_receipt(run:symbol, disposition:symbol)
latest_receipt(R,D) :-
  receipt(R,D,N),
  !superseded_receipt(R,N).

.decl matching_run(run:symbol, obligation:symbol, sequence:number)
matching_run(R,O,N) :-
  run(R,O,K,N),
  semantic_key(O,K).

.decl done(obligation:symbol)
done(O) :-
  matching_run(R,O,N),
  latest_receipt(R,"DONE"),
  admissible_run(R).

.decl superseded_matching_run(run:symbol)
superseded_matching_run(R) :-
  matching_run(R,O,N),
  matching_run(R2,O,N2),
  N2>N.

.decl latest_matching_run(run:symbol, obligation:symbol)
latest_matching_run(R,O) :-
  matching_run(R,O,N),
  !superseded_matching_run(R).

.decl has_latest_receipt(run:symbol)
has_latest_receipt(R) :- latest_receipt(R,D).

.decl executing(obligation:symbol)
executing(O) :-
  latest_matching_run(R,O),
  !done(O),
  !has_latest_receipt(R).

.decl waiting(obligation:symbol)
waiting(O) :-
  latest_matching_run(R,O),
  !done(O),
  latest_receipt(R,"WAITING").

.decl recovery_required(obligation:symbol)
recovery_required(O) :-
  latest_matching_run(R,O),
  !done(O),
  latest_receipt(R,"RECOVERY_REQUIRED").

.decl unrealized(obligation:symbol)
unrealized(O) :-
  obligation(O),
  !done(O),
  !executing(O),
  !waiting(O),
  !recovery_required(O).

.decl unsatisfied_dependency(obligation:symbol)
unsatisfied_dependency(O) :-
  dependency(O,U),
  !done(U).

.decl blocked(obligation:symbol)
blocked(O) :-
  unrealized(O),
  unsatisfied_dependency(O).

blocked(O) :-
  unrealized(O),
  !semantic_key(O,_).

.decl ready(obligation:symbol)
ready(O) :-
  unrealized(O),
  semantic_key(O,K),
  !unsatisfied_dependency(O).

.decl project_status(obligation:symbol, status:symbol)
project_status(O,"DONE") :- done(O).
project_status(O,"EXECUTING") :- executing(O).
project_status(O,"WAITING") :- waiting(O).
project_status(O,"RECOVERY_REQUIRED") :- recovery_required(O).
project_status(O,"BLOCKED") :- blocked(O).
project_status(O,"READY") :- ready(O).

.output project_status
